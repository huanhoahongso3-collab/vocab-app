PORT=3000
JWT_SECRET=change-me
DB_PATH=./vocab.db
# Same AI as cbh-youth-online (AiChatService.php)
AI_URL=https://chat-api.chuyenbienhoa.com/v1/chat/completions
AI_MODEL=gemini-auto
CYO_AI_API=
# Google Play billing
GOOGLE_PACKAGE_NAME=dhp.fatties.vocab
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
# Apple App Store billing
APPLE_BUNDLE_ID=dhp.fatties.vocab
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_FILE=./AuthKey.p8
APPLE_ENV=sandbox
# Shared secret appended to the Google Pub/Sub push URL: /billing/google/rtdn?token=...
GOOGLE_RTDN_SECRET=
# Email (any SMTP: Resend smtp.resend.com, Brevo, Amazon SES, Gmail app password...). Empty SMTP_HOST = log codes to console (dev only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Vocab <no-reply@example.com>"
